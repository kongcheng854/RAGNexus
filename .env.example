APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_center

MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=your-api-key
EMBEDDING_MODEL=text-embedding-3-small

VECTOR_STORE=pgvector
DOCUMENT_STORAGE_PATH=./data/uploads
DOCUMENT_MAX_SIZE_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TABLE_MAX_ROWS_PER_CHUNK=10
TOP_K=5

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60

QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_MS=2000

RERANK_ENABLED=false
RERANK_PROVIDER=llm
RERANK_TOP_N=5
RERANK_MAX_CANDIDATES=20
RERANK_CHUNK_MAX_CHARS=1000
RERANK_TEMPERATURE=0.0

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_QUEUE_SIZE=4096
LOG_COLOR=true
LOG_PAYLOADS=false
LOG_PAYLOAD_LIMIT=2048
KEYWORD_SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_chunks
ELASTICSEARCH_TIMEOUT_SECONDS=10
QUERY_MAX_LENGTH=2000
RETRIEVAL_MODE=vector
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_TOP_N=20

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AUTH_ENABLED=true

# Optional retrieval tracing. Project keys are issued in the Langfuse UI.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The API container reaches the bundled server by its Compose service name.
LANGFUSE_DOCKER_HOST=http://langfuse:3000
# For self-hosting, generate each value separately with: openssl rand -hex 32
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
